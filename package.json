{
  "name": "open-api-proxy",
  "version": "0.1.0",
  "description": "A lightweight local API proxy providing unified entry for all LLM providers with automatic protocol format conversion",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "open-api-proxy": "dist/index.js"
  },
  "files": [
    "dist",
    "config.yaml"
  ],
  "keywords": [
    "llm",
    "api-proxy",
    "openai",
    "anthropic",
    "protocol-conversion"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/leenixp/open-api-proxy"
  },
  "author": "LiPeng",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "tsc && vite build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/leenixp/open-api-proxy/issues"
  },
  "homepage": "https://github.com/leenixp/open-api-proxy#readme",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@tailwindcss/postcss": "^4.3.0",
    "clsx": "^2.1.1",
    "fastify": "^5.8.5",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
